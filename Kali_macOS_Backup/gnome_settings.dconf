[background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file://~/.local/share/backgrounds/2025-06-17-20-18-10-newfixHD.jpg'
picture-uri-dark='file://~/.local/share/backgrounds/2025-06-17-20-18-10-newfixHD.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[break-reminders]
selected-breaks=@as []

[break-reminders/eyesight]
play-sound=true

[break-reminders/movement]
duration-seconds=uint32 300
interval-seconds=uint32 1800
play-sound=true

[calendar]
show-weekdate=true

[datetime]
automatic-timezone=true

[input-sources]
mru-sources=[('xkb', 'us'), ('xkb', 'id')]
sources=[('xkb', 'us'), ('xkb', 'id')]

[interface]
accent-color='yellow'
clock-format='12h'
clock-show-seconds=true
clock-show-weekday=true
color-scheme='prefer-dark'
cursor-blink-time=2500
cursor-size=24
document-font-name='Cantarell Bold Italic 10 @wght=700'
enable-animations=true
font-antialiasing='rgba'
font-hinting='medium'
font-name='Cantarell Bold Italic 10 @wght=700'
gtk-enable-primary-paste=true
gtk-key-theme='Default'
gtk-theme='adw-gtk3-yellow-dark'
icon-theme='WhiteSur-light'
monospace-font-name='Fira Code Semi-Bold 10'
overlay-scrolling=true
show-battery-percentage=true
text-scaling-factor=0.95999999999999996
toolkit-accessibility=false

[media-handling]
automount=true

[notifications]
application-children=['gnome-power-panel', 'org-gnome-terminal-preferences', 'org-gnome-nautilus', 'org-gnome-terminal', 'firefox-esr', 'cursor', 'kali-burpsuite', 'discord', 'libreoffice-writer', 'spotify', 'org-gnome-extensions', 'gnome-about-panel', 'org-gnome-evolution-alarm-notify', 'org-gnome-goa-daemon', 'org-flameshot-flameshot', 'grub-customizer']
