[peripherals/keyboard]
numlock-state=false

[peripherals/mouse]
accel-profile='default'
left-handed=false
natural-scroll=false
speed=1.0

[peripherals/touchpad]
click-method='areas'
edge-scrolling-enabled=true
speed=1.0
two-finger-scrolling-enabled=false

[privacy]
old-files-age=uint32 5

[remote-desktop/rdp]
enable=true
tls-cert='~/.local/share/gnome-remote-desktop/certificates/rdp-tls.crt'
tls-key='~/.local/share/gnome-remote-desktop/certificates/rdp-tls.key'
view-only=false

[screen-time-limits]
daily-limit-enabled=false
grayscale=false

[screensaver]
color-shading-type='solid'
lock-enabled=false
picture-options='zoom'
picture-uri='file://~/.local/share/backgrounds/2025-06-17-20-18-10-newfixHD.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[search-providers]
sort-order=['org.gnome.Settings.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.Nautilus.desktop']

[session]
idle-delay=uint32 0

[sound]
allow-volume-above-100-percent=true

[wm/keybindings]
maximize=@as []
unmaximize=@as []

[wm/preferences]
action-middle-click-titlebar='none'
auto-raise=true
button-layout='appmenu:minimize,maximize,close'
focus-mode='click'
resize-with-right-button=false
visual-bell=false
visual-bell-type='fullscreen-flash'
workspace-names=@as []
